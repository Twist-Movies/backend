SECRET_KEY='your-secret-key-here'
DEBUG='your-debug-mode-here'

DATABASE_URL='your-database-url-here'

SUPABASE_URL='https://xxxxxxxx.supabase.co'
SUPABASE_SERVICE_KEY='your-service-role-key-here'

TMDB_API_KEY='your-tmdb-api-key-or-read-access-token-here'
# Recuperação de senha / e-mail. Use BREVO_API_KEY (não exige domínio; o remetente precisa estar
# verificado no Brevo) ou RESEND_API_KEY. Sem nenhuma das duas, os e-mails saem no console.
BREVO_API_KEY='your-brevo-api-key-here'
# RESEND_API_KEY='your-resend-api-key-here'
DEFAULT_FROM_EMAIL='Twist <seu-remetente-verificado@exemplo.com>'
FRONTEND_URL='http://localhost:5173'
PASSWORD_RESET_TIMEOUT=3600

# Cookie HttpOnly do refresh token (opcionais). SECURE padrão: False com DEBUG, True caso contrário.
# Em produção com front e API em domínios diferentes: SAMESITE='None' (exige Secure/HTTPS).
# REFRESH_COOKIE_NAME='twist_refresh'
# REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_SAMESITE='Lax'

# Limites de requisição (opcionais; valores padrão abaixo). Contadores no cache `ratelimit`
# (rode `python manage.py createcachetable`). NUM_PROXIES: Render tem 1 proxy na frente.
# NUM_PROXIES=1
# THROTTLE_ANON='240/min'
# THROTTLE_USER='600/min'
# THROTTLE_LOGIN='20/min'
# LOGIN_FAILURE_LIMIT=8
# LOGIN_FAILURE_WINDOW=900
# THROTTLE_REGISTER='5/hour'
# THROTTLE_TMDB='120/min'
# THROTTLE_PASSWORD_RESET_REQUEST='5/hour'
# THROTTLE_PASSWORD_RESET_CONFIRM='10/hour'

# Produção (opcionais; ver README, seção Produção)
# CORS_ALLOWED_ORIGINS='https://twist-frontend.onrender.com'
# CSRF_TRUSTED_ORIGINS='https://twist-api.onrender.com'
# REFRESH_COOKIE_SAMESITE='None'   # 'Lax' se /api for servido pelo mesmo domínio do front
# ENABLE_DOCS=False
# ADMIN_URL='admin/'
# PASSWORD_RESET_EMAIL_ASYNC=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

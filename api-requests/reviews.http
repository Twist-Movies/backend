# Comentários — /api/movies/{tmdb_id}/reviews/ e /api/reviews/{id}/

@baseUrl = http://localhost:8000/api
@tmdbId = 603

### Login
# @name login
POST {{baseUrl}}/accounts/login/
Content-Type: application/json

{
  "identifier": "twist_demo",
  "password": "Tw1st!Senha#Forte"
}

###
@accessToken = {{login.response.body.access}}

### Criar comentário (um comentário ativo por usuário e filme)
# @name createReview
POST {{baseUrl}}/movies/{{tmdbId}}/reviews/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "Um clássico da ficção científica.",
  "contains_spoiler": false
}

###
@reviewId = {{createReview.response.body.id}}

### Comentários do filme (público, paginado)
GET {{baseUrl}}/movies/{{tmdbId}}/reviews/

### Consultar comentário (público)
GET {{baseUrl}}/reviews/{{reviewId}}/

### Editar comentário (só o autor)
PATCH {{baseUrl}}/reviews/{{reviewId}}/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "Revendo: continua genial.",
  "contains_spoiler": true
}

### Curtir comentário
POST {{baseUrl}}/reviews/{{reviewId}}/like/
Authorization: Bearer {{accessToken}}

### Remover curtida
DELETE {{baseUrl}}/reviews/{{reviewId}}/like/
Authorization: Bearer {{accessToken}}

### Excluir comentário (só o autor)
DELETE {{baseUrl}}/reviews/{{reviewId}}/
Authorization: Bearer {{accessToken}}


### Feed: comentários de quem sigo
GET {{baseUrl}}/feed/
Authorization: Bearer {{accessToken}}
